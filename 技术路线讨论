# 伪代码：Central Runtime 切换逻辑
def switch_to_ego(target_pos):
    # 1. 安全悬停
    mux_client.switch('hover_channel') 

    # 2. 只有在真机资源紧张时才 Kill FALCON，仿真随便跑
    # rosnode.kill('/falcon_planner') 

    # 3. 启动 EGO (如果没启动)
    if not is_running('/ego_planner'):
        subprocess.Popen(['roslaunch', 'ego_planner', 'run.launch'])
        rospy.sleep(1.0) # 等待 EGO 建立局部地图

    # 4. 发送目标点给 EGO
    ego_goal_pub.publish(target_pos)

    # 5. 切控制权
    mux_client.switch('ego_channel')
