<?xml version="1.0"?>
<sdf version="1.6">
  <model name="falcon_cam_uav">
    <static>false</static>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="base_vis">
              <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
              <material><script><name>Gazebo/DarkGrey</name></script></material>
            </visual>

            <visual name="arms_vis">
              <geometry><box><size>0.6 0.03 0.015</size></box></geometry>
              <pose>0 0 0 0 0 0.785</pose>
            </visual>
            <visual name="arms_vis_2">
              <geometry><box><size>0.6 0.03 0.015</size></box></geometry>
              <pose>0 0 0 0 0 -0.785</pose>
            </visual>

            <visual name="motor_1"><pose>0.21 0.21 0.02 0 0 0</pose>
              <geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry>
              <material><script><name>Gazebo/Black</name></script></material>
            </visual>
            <visual name="motor_2"><pose>-0.21 0.21 0.02 0 0 0</pose>
              <geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry>
              <material><script><name>Gazebo/Black</name></script></material>
            </visual>
            <visual name="motor_3"><pose>0.21 -0.21 0.02 0 0 0</pose>
              <geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry>
              <material><script><name>Gazebo/Black</name></script></material>
            </visual>
            <visual name="motor_4"><pose>-0.21 -0.21 0.02 0 0 0</pose>
              <geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry>
              <material><script><name>Gazebo/Black</name></script></material>
            </visual>

            <visual name="prop_1"><pose>0.21 0.21 0.04 0 0 0</pose>
              <geometry><cylinder><radius>0.05</radius><length>0.005</length></cylinder></geometry>
              <material><script><name>Gazebo/White</name></script></material> </visual>
            <visual name="prop_2"><pose>-0.21 0.21 0.04 0 0 0</pose>
              <geometry><cylinder><radius>0.05</radius><length>0.005</length></cylinder></geometry>
              <material><script><name>Gazebo/White</name></script></material>
            </visual>
            <visual name="prop_3"><pose>0.21 -0.21 0.04 0 0 0</pose>
              <geometry><cylinder><radius>0.05</radius><length>0.005</length></cylinder></geometry>
              <material><script><name>Gazebo/White</name></script></material>
            </visual>
            <visual name="prop_4"><pose>-0.21 -0.21 0.04 0 0 0</pose>
              <geometry><cylinder><radius>0.05</radius><length>0.005</length></cylinder></geometry>
              <material><script><name>Gazebo/White</name></script></material>
            </visual>

      <!-- Camera sensor -->
      <sensor name="rgb_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>

        <!-- ROS bridge plugin -->
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <cameraName>camera</cameraName>
          <frameName>camera_link</frameName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        </plugin>
      </sensor>

    </link>
  </model>
</sdf>
