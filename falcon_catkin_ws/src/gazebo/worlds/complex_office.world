<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- 光照 -->
    <scene>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <background>0.7 0.7 0.7 1.0</background>
          <shadows>true</shadows>
          <grid>true</grid>
        </scene>

        <light name='main_sun' type='directional'>
          <cast_shadows>1</cast_shadows>
          <pose>0 0 15 0.6 0.2 0</pose>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <attenuation>
            <range>1000</range>
            <constant>0.9</constant>
            <linear>0.01</linear>
            <quadratic>0.001</quadratic>
          </attenuation>
          <direction>-0.5 0.2 -0.9</direction>
        </light>

    <!-- 地面（可选，但建议有，方便定位） -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 你的迷宫墙体 mesh 地图 -->
    <model name="complex_office_map">
      <static>true</static>
      <pose>15.5 15.5 -0.5  0 0 -1.5708</pose>
      <link name="map_link">
        <visual name="map_visual">
          <geometry>
            <mesh>
              <uri>file:///root/catkin_ws/src/FALCON/uav_simulator/map_render/resource/untitled_v1.dae</uri>
            <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    
    <include>
    <uri>model:///root/catkin_ws/src/gazebo</uri>
    <name>gz_uav</name>
    <pose>-6 0 1 0 0 0</pose>
    </include>

    <!-- <include>
    <uri>model:///root/catkin_ws/src/gazebo/poster_plane</uri>
    <name>poster1</name>
    <pose>11 7.9 2 0 0 0</pose>
    </include> -->

    <include>
    <uri>model:///root/catkin_ws/src/gazebo/poster_plane 1</uri>
    <name>poster2</name>
    <pose>8.61662 4.49831 2 0 -0 1.57</pose>
    </include>
        
    <include>
    <uri>model:///root/catkin_ws/src/gazebo/poster_plane 2</uri>
    <name>poster3</name>
    <pose>7.76 8.33 2 0 0 1.57</pose>
    </include>

    <include>
    <uri>model:///root/catkin_ws/src/gazebo/poster_plane 3</uri>
    <name>poster4</name>
    <pose>-14 -14 2 0 0 0</pose>
    </include>

  </world>
</sdf>
