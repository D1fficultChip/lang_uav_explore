<launch>
  <arg name="map_name" default="small_house"/>

  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="1.0"/>
  <arg name="init_yaw" default="0.0"/>

  <arg name="odometry_topic" default="/uav_simulator/odometry"/>
  <arg name="sensor_pose_topic" default="/uav_simulator/sensor_pose"/>
  <arg name="depth_image" default="/uav_simulator/depth_image"/>
  <arg name="pose_topic_type" default="transform"/>

  <!-- Optional runtime overrides for scene-specific tuning. -->
  <arg name="traj_init_dx" default="1.0"/>
  <arg name="traj_init_dy" default="0.0"/>
  <arg name="traj_init_dz" default="1.0"/>
  <arg name="frontier_cluster_min" default="100"/>
  <arg name="frontier_min_visib_num" default="15"/>
  <arg name="frontier_candidate_rmin" default="1.5"/>
  <arg name="frontier_candidate_rmax" default="2.5"/>
  <arg name="frontier_candidate_rnum" default="3"/>
  <arg name="frontier_min_candidate_clearance" default="0.21"/>
  <arg name="frontier_min_candidate_occupied_clearance" default="0.5"/>
  <arg name="frontier_ground_offset" default="0.1"/>
  <arg name="frontier_min_view_finish_fraction" default="0.25"/>

  <!-- Load parameter for planner modules (keep minimal but safe) -->
  <rosparam command="load" file="$(find exploration_manager)/config/robot/uav_model_simulator.yaml"/>
  <rosparam command="load" file="$(find exploration_manager)/config/map/$(arg map_name).yaml"/>
  <rosparam command="load" file="$(find voxel_mapping)/config/voxel_mapping.yaml"/>
  <rosparam command="load" file="$(find pathfinding)/config/astar.yaml"/>
  <rosparam command="load" file="$(find fast_planner)/config/fast_planner.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/frontier_finder.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/hgrid.yaml"/>
  <rosparam command="load" file="$(find exploration_utils)/config/perception_utils.yaml"/>
  <rosparam command="load" file="$(find exploration_manager)/config/exploration_manager.yaml"/>

  <!-- Apply scene-specific overrides after config files are loaded. -->
  <param name="/map_config/init_x" value="$(arg init_x)"/>
  <param name="/map_config/init_y" value="$(arg init_y)"/>
  <param name="/map_config/init_z" value="$(arg init_z)"/>
  <param name="/map_config/init_yaw" value="$(arg init_yaw)"/>
  <param name="/transformer/pose_topic_type" value="$(arg pose_topic_type)"/>
  <param name="/traj_server/init_dx" value="$(arg traj_init_dx)"/>
  <param name="/traj_server/init_dy" value="$(arg traj_init_dy)"/>
  <param name="/traj_server/init_dz" value="$(arg traj_init_dz)"/>
  <param name="/frontier_finder/cluster_min" value="$(arg frontier_cluster_min)"/>
  <param name="/frontier_finder/min_visib_num" value="$(arg frontier_min_visib_num)"/>
  <param name="/frontier_finder/candidate_rmin" value="$(arg frontier_candidate_rmin)"/>
  <param name="/frontier_finder/candidate_rmax" value="$(arg frontier_candidate_rmax)"/>
  <param name="/frontier_finder/candidate_rnum" value="$(arg frontier_candidate_rnum)"/>
  <param name="/frontier_finder/min_candidate_clearance"
         value="$(arg frontier_min_candidate_clearance)"/>
  <param name="/frontier_finder/min_candidate_occupied_clearance"
         value="$(arg frontier_min_candidate_occupied_clearance)"/>
  <param name="/frontier_finder/ground_offset" value="$(arg frontier_ground_offset)"/>
  <param name="/frontier_finder/min_view_finish_fraction"
         value="$(arg frontier_min_view_finish_fraction)"/>

  <!-- Launch exploration node (FALCON planner) -->
  <node pkg="exploration_manager" name="exploration_node" type="exploration_node" output="screen">
    <remap from="/odom_world" to="$(arg odometry_topic)"/>
    <remap from="/voxel_mapping/depth_image" to="$(arg depth_image)"/>
    <remap from="/transformer/sensor_pose_topic" to="$(arg sensor_pose_topic)"/>
  </node>

  <!-- Trajectory server: publish to falcon private cmd -->
  <node pkg="fast_planner" name="traj_server" type="traj_server" output="screen">
    <remap from="/planning/pos_cmd" to="/falcon/pos_cmd"/>
  </node>
</launch>
