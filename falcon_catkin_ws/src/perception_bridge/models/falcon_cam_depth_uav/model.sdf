<?xml version="1.0"?>
<sdf version="1.6">
  <model name="falcon_cam_depth_uav">
    <static>false</static>

    <link name="base_link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <self_collide>false</self_collide>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.1</iyy>
          <iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <visual name="base_vis">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>

      <visual name="arms_vis_1">
        <geometry>
          <box>
            <size>0.6 0.03 0.015</size>
          </box>
        </geometry>
        <pose>0 0 0 0 0 0.785</pose>
      </visual>
      <visual name="arms_vis_2">
        <geometry>
          <box>
            <size>0.6 0.03 0.015</size>
          </box>
        </geometry>
        <pose>0 0 0 0 0 -0.785</pose>
      </visual>

      <visual name="camera_pod">
        <pose>0.10 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.06 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
          </script>
        </material>
      </visual>

      <sensor name="rgb_camera" type="camera">
        <pose>0.10 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
        <plugin name="gazebo_ros_rgb_camera" filename="libgazebo_ros_camera.so">
          <robotNamespace>/uav_simulator</robotNamespace>
          <cameraName>rgb_camera</cameraName>
          <frameName>camera_rgb_optical_frame</frameName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        </plugin>
      </sensor>

      <sensor name="depth_camera" type="depth">
        <pose>0.10 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
        <plugin name="gazebo_ros_depth_camera" filename="libgazebo_ros_depth_camera.so">
          <robotNamespace>/uav_simulator</robotNamespace>
          <cameraName>depth_camera</cameraName>
          <frameName>camera_depth_optical_frame</frameName>
          <imageTopicName>depth_image</imageTopicName>
          <cameraInfoTopicName>depth_camera_info</cameraInfoTopicName>
          <pointCloudTopicName>depth_points</pointCloudTopicName>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
