+def _safe_float(v, default=0.0):
+    try:
+        return float(v)
+    except Exception:
+        return float(default)
+
+
+def mask_quality_from_bbox(mask_score: float, bbox_xyxy, img_w: int, img_h: int) -> float:
+    if bbox_xyxy is None or img_w <= 0 or img_h <= 0:
+        return max(0.0, min(1.0, float(mask_score)))
+    x1, y1, x2, y2 = bbox_xyxy
+    box_area = max(0.0, float(x2 - x1)) * max(0.0, float(y2 - y1))
+    area_ratio = box_area / max(float(img_w * img_h), 1.0)
+    area_term = 1.0 - min(1.0, abs(area_ratio - 0.10) / 0.10)
+    quality = 0.7 * _safe_float(mask_score) + 0.3 * max(0.0, area_term)
+    return max(0.0, min(1.0, quality))
+
+
+def spatial_hint_from_bbox(bbox_xyxy, img_w: int, img_h: int):
+    if bbox_xyxy is None or img_w <= 0 or img_h <= 0:
+        return {}
+    x1, y1, x2, y2 = [float(v) for v in bbox_xyxy]
+    cx = 0.5 * (x1 + x2)
+    cy = 0.5 * (y1 + y2)
+    cx_n = max(0.0, min(1.0, cx / float(img_w)))
+    cy_n = max(0.0, min(1.0, cy / float(img_h)))
+    area_ratio = max(0.0, min(1.0, ((x2 - x1) * (y2 - y1)) / max(float(img_w * img_h), 1.0)))
+
+    if cx_n < 0.33:
+        x_bucket = "left"
+    elif cx_n > 0.67:
+        x_bucket = "right"
+    else:
+        x_bucket = "center"
+
+    if cy_n < 0.33:
+        y_bucket = "top"
+    elif cy_n > 0.67:
+        y_bucket = "bottom"
+    else:
+        y_bucket = "center"
+
+    return {
+        "image_region": f"{x_bucket}_{y_bucket}",
+        "center_xy_norm": [cx_n, cy_n],
+        "box_area_ratio": area_ratio,
+    }
+
+
+def proposal_status_from_candidates(candidates, *, ambiguous_gap: float, low_quality_flag: bool) -> str:
+    if not candidates:
+        return "no_candidate"
+    top1 = _safe_float(candidates[0].get("score", 0.0))
+    if top1 <= 0.0:
+        return "low_confidence"
+    if len(candidates) >= 2:
+        top2 = _safe_float(candidates[1].get("score", 0.0))
+        if abs(top1 - top2) < ambiguous_gap:
+            return "multi_candidate_ambiguous"
+    if low_quality_flag:
+        return "low_confidence"
+    if len(candidates) == 1:
+        return "single_candidate"
+    return "stable_primary_candidate"
+
+
+def uncertainty_from_candidates(candidates, *, low_mask_confidence: bool):
+    if not candidates:
+        return {
+            "multi_candidate": False,
+            "ambiguous_top2_gap": None,
+            "low_mask_confidence": low_mask_confidence,
+        }
+    gap = None
+    if len(candidates) >= 2:
+        gap = max(0.0, _safe_float(candidates[0].get("score", 0.0)) - _safe_float(candidates[1].get("score", 0.0)))
+    return {
+        "multi_candidate": len(candidates) > 1,
+        "ambiguous_top2_gap": gap,
+        "low_mask_confidence": bool(low_mask_confidence),
+    }
+
+def best_binary_mask(masks, best_idx: int, img_w: int, img_h: int):
+    if masks is None:
+        return None
+    masks_n = masks[None, ...] if masks.ndim == 2 else masks
+    if best_idx < 0 or best_idx >= masks_n.shape[0]:
+        return None
+    m = masks_n[best_idx]
+    if m.dtype != np.bool_:
+        m = m > 0.5
+    if m.shape[0] != img_h or m.shape[1] != img_w:
+        m = cv2.resize(m.astype(np.uint8), (img_w, img_h), interpolation=cv2.INTER_NEAREST).astype(bool)
+    return (m.astype(np.uint8) * 255)
+
