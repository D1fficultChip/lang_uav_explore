+def read_perception_request_cached(last_mtime: float, cache: dict):
+    """
+    Returns (new_mtime, req_dict_or_cache)
+
+    req format (written by central_runtime):
+      {
+        "req_id": 7,
+        "stage_id": "S1",
+        "primary": {"entity_id":"E_car","prompt":"car."},
+        "cues": [{"entity_id":"E_exit","prompt":"safe exit."}]
+      }
+    """
+    if not REQ_PATH.exists():
+        return last_mtime, cache
+
+    try:
+        m = REQ_PATH.stat().st_mtime
+    except Exception:
+        return last_mtime, cache
+
+    if m <= last_mtime:
+        return last_mtime, cache
+
+    try:
+        raw = REQ_PATH.read_text()
+        obj = json.loads(raw)
+        if not isinstance(obj, dict):
+            return last_mtime, cache
+        # minimal validation
+        if "primary" not in obj or not isinstance(obj["primary"], dict):
+            return last_mtime, cache
+        return m, obj
+    except Exception:
+        # If central_runtime is in the middle of atomic replace, json may be transiently invalid.
+        return last_mtime, cache
